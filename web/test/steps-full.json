[
{
"until": "window.lakonGame && lakonGame.mode === 'title'"
},
{
"wait": 500
},
{
"key": "Enter"
},
{
"until": "lakonGame.world.message && lakonGame.world.message.isTextComplete"
},
{
"key": "Enter"
},
{
"until": "lakonGame.nameUI"
},
{
"wait": 400
},
{
"shot": "03-name"
},
{
"eval": "lakonGame.nameUI.name = 'Bimo'; lakonGame.nameUI.cursor = 64; 'ok'"
},
{
"key": "Enter"
},
{
"until": "!lakonGame.nameUI && lakonGame.world.message && lakonGame.world.message.isTextComplete"
},
{
"key": "Enter"
},
{
"until": "!lakonGame.world.isEventRunning",
